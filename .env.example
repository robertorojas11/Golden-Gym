# Golden Gym Access Control System - Environment Configuration Template
# Copy this file to '.env' and modify the values for your deployment.

# ==========================================
# DATABASE SEED CONFIGURATION
# ==========================================
# Use 'seeds.sql' to include demo/mock data (default for local testing).
# Use 'clean-seeds.sql' to deploy a new gym with zero mock members or payments.
SEEDS_FILE=clean-seeds.sql

# ==========================================
# 🔑 SECURITY & JWT CONFIGURATION
# ==========================================
# Change this to a secure random string in production!
JWT_SECRET=super_secure_production_key_change_me_983719

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_USER=gym_admin
POSTGRES_DB=goldengym_access

# IMPORTANT: Change this password to a secure one before deploying!
POSTGRES_PASSWORD=change_this_to_a_secure_database_password_98273

# Internal database hostname and port (defaults match docker-compose internal network)
DB_HOST=postgres
DB_PORT=5432
DB_USER=gym_admin
DB_PASSWORD=change_this_to_a_secure_database_password_98273
DB_NAME=goldengym_access

# ==========================================
# APPLICATION PORTS & ENVIRONMENT
# ==========================================
NODE_ENV=production
PORT=3000
